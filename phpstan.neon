parameters:
  level: 9
  paths:
    - src
  excludePaths:
    - src/Migrations/*
  treatPhpDocTypesAsCertain: false
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    - identifier: missingType.iterableValue
    - identifier: missingType.generics
    - identifier: trait.unused
    -
      # Composer\Script\Event is provided by the Composer runtime executing this script,
      # not by a declared dependency (composer/composer is not required, only used at dev-time).
      identifier: class.notFound
      path: src/Composer/ScriptHandler.php
