{% if allowDisplay is same as (true) %}
    <sweet-alert title="{{ swalTitle }}" text="{{ swalText }}" color="{{ swalColor }}" cancelButtonText="{{ 'cancel'|trans }}" confirmButtonText="{{ 'i_confirm'|trans }}">
        <twig:ButtonLink
                color="{{ color }}"
                mode="{{ mode }}"
                block="{{ block }}"
                label="{{ label }}"
                link="{{ link }}"
                target="{{ target }}"
                icon="{{ icon }}"
                iconPlacement="{{ iconPlacement }}"
                size="{{ size }}"
                tooltip="{{ tooltip }}"
        />
    </sweet-alert>
{% endif %}
