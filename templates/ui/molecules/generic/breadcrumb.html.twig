<div class="flex items-center justify-between mb-10">
    <ol class="breadcrumb" aria-label="Breadcrumb">
        {% for item in items %}
            {% if item is not empty %}
                <li {% if loop.last %}aria-current="page"{% endif %}>
                    {% if loop.last %}
                        {{ item.label|raw }}
                    {% else %}
                        <a href="{{ item.path }}">
                            {{ item.label|raw }}
                            <twig:ux:icon name="fa6-solid:chevron-right" />
                        </a>
                    {% endif %}
                </li>
            {% endif %}
        {% endfor %}
    </ol>

    {% block breadcrumbActions %}{% endblock %}
</div>
