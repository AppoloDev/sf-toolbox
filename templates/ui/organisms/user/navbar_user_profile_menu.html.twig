<div class="navbar_user_profile_menu">
    <twig:DropdownMenu>
        {% block dropdownButton %}
            <twig:Button
                    label="{{ app.user.firstname }}"
                    icon="{{ source('@SFToolbox/icons/chevron-down.svg') }}"
                    mode="solid"
                    iconPlacement="right"
                    color="{{ themeColor }}"
            />
        {% endblock %}

        {% block dropdownItems %}
            <twig:DropdownItemContainer>
                {% block dropdownItemContainerItems %}
                    <twig:ButtonLink
                        link="{{ path(routePrefix~'_account_edit') }}"
                        label="{{ 'user_profil_my_profile'|trans }}"
                        mode="ghost"
                        block="true"
                        size="small"
                        />
                    <twig:ButtonLink
                            link="{{ path('auth_logout') }}"
                            label="{{ 'auth_logout'|trans }}"
                            mode="ghost"
                            block="true"
                            size="small"
                            color="red"
                    />
                {% endblock %}
            </twig:DropdownItemContainer>
        {% endblock %}
    </twig:DropdownMenu>
</div>
