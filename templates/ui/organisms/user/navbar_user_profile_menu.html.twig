<div class="navbar_user_profile_menu">
    <twig:DropdownMenu>
        <twig:block name="dropdownButton">
            <twig:Button
                    label="{{ app.user.firstname }}"
                    icon="{{ ux_icon('fa6-solid:chevron-down') }}"
                    mode="solid"
                    iconPlacement="right"
                    color="{{ themeColor }}"
            />
        </twig:block>

        <twig:block name="dropdownItems">
            <twig:DropdownItemContainer>
                <twig:block name="dropdownItemContainerItems">
                    <twig:ButtonLink
                            link="{{ path(routePrefix~'_account_edit') }}"
                            label="{{ 'user_profil_my_profile'|trans }}"
                            mode="ghost"
                            :block="true"
                            size="small"
                    />
                    <twig:ButtonLink
                            link="{{ path('auth_logout') }}"
                            label="{{ 'auth_logout'|trans }}"
                            mode="ghost"
                            :block="true"
                            size="small"
                            color="red"
                    />
                </twig:block>
            </twig:DropdownItemContainer>
        </twig:block>
    </twig:DropdownMenu>
</div>
