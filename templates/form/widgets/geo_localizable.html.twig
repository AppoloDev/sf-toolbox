{% block geo_localizable_widget %}
   <div class="form_row {{ not valid ? 'invalid' }}">
      <geo-complete api-key="{{ googleMapApiKey }}" source=".source" target="#{{ id }}" request-options="{{ requestOptions|json_encode }}">
         {{ form_label(form) }}
         {{ form_widget(form) }}
         <input type="text" placeholder="{{ placeholder|trans }}" class="source">
         <ul>
         </ul>
         {{ form_errors(form) }}
      </geo-complete>
   </div>
{% endblock %}
