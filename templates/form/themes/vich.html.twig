{%- block vich_image_widget -%}
    <vich-image>
        <div class="image-preview {% if not image_uri %}no-image{% endif %}">
            {%- if image_uri -%}
                <img src="{{ asset_helper is same as(true) ? asset(image_uri) : image_uri }}" alt=""/>
            {% else %}
                <img src="" alt=""/>
            {%- endif -%}
            <a class="btn btn-size-default btn-color-appolo btn-mode-ghost bg-mode-white">
                {{ ux_icon('fa6-solid:trash') }}
            </a>
        </div>


        <div class="form {% if image_uri %}hidden{% endif %}">
            {%- if errors|length > 0 -%}
                {%- set attr = attr|merge({class: (attr.class|default('') ~ ' is-invalid')|trim}) -%}
            {%- endif -%}
            {{- form_widget(form.file, {attr: attr}) -}}
            {%- if form.delete is defined -%}
                <div class="form-delete">
                    {{- form_row(form.delete) -}}
                </div>
            {%- endif -%}
        </div>
    </vich-image>
{%- endblock -%}

{%- block vich_file_widget -%}
    <vich-file>
        {% if object is not null and object.fileName is not null %}
            <twig:CardFile file="{{ object }}" />
        {% endif %}

        <div class="{% if object is not null and object.fileName is not null %}hidden{% endif %}">
            {%- if errors|length > 0 -%}
                {%- set attr = attr|merge({class: (attr.class|default('') ~ ' is-invalid')|trim}) -%}
            {%- endif -%}
            {{- form_widget(form.file, {attr: attr}) -}}
            {%- if form.delete is defined -%}
                {{- form_row(form.delete) -}}
            {%- endif -%}
        </div>
    </vich-file>
{%- endblock -%}
