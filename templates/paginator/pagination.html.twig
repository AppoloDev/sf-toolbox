{% if pageCount > 1 %}
    <div class="inline-flex gap-x-2 justify-end">
        {% if previous is defined %}
            <twig:ButtonLink
                    color="{{ themeColor }}"
                    mode="white"
                    label="{{ 'previous'|trans }}"
                    link="{{ path(route, query|merge({(pageParameterName): previous})) }}"
                    icon="{{ ux_icon('fa6-solid:chevron-left') }}"
                    size="small"
            />
        {% else %}
            <twig:Button
                    color="{{ themeColor }}"
                    mode="white"
                    label="{{ 'previous'|trans }}"
                    :disabled="true"
                    icon="{{ ux_icon('fa6-solid:chevron-left') }}"
                    size="small"
            />
        {% endif %}

        {% if next is defined %}
            <twig:ButtonLink
                    color="{{ themeColor }}"
                    mode="white"
                    label="{{ 'next'|trans }}"
                    link="{{ path(route, query|merge({(pageParameterName): next})) }}"
                    icon="{{ ux_icon('fa6-solid:chevron-right') }}"
                    iconPlacement="right"
                    size="small"
            />
        {% else %}
            <twig:Button
                    color="{{ themeColor }}"
                    mode="white"
                    label="{{ 'next'|trans }}"
                    :disabled="true"
                    icon="{{ ux_icon('fa6-solid:chevron-right') }}"
                    iconPlacement="right"
                    size="small"
            />
        {% endif %}
    </div>
{% endif %}
