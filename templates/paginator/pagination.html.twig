{% if pageCount > 1 %}
    <div class="inline-flex gap-x-2 justify-end">
        {% if previous is defined %}
            <twig:ButtonLink
                    color="{{ themeColor }}"
                    mode="white"
                    label="Précédent"
                    link="{{ path(route, query|merge({(pageParameterName): previous})) }}"
                    icon="{{ source('@SFToolbox/icons/chevron-left.svg') }}"
                    size="small"
            />
        {% else %}
            <twig:Button
                    color="{{ themeColor }}"
                    mode="white"
                    label="Précédent"
                    disabled="{{ true }}"
                    icon="{{ source('@SFToolbox/icons/chevron-left.svg') }}"
                    size="small"
            />
        {% endif %}

        {% if next is defined %}
            <twig:ButtonLink
                    color="{{ themeColor }}"
                    mode="white"
                    label="Suivant"
                    link="{{ path(route, query|merge({(pageParameterName): next})) }}"
                    icon="{{ source('@SFToolbox/icons/chevron-right.svg') }}"
                    iconPlacement="right"
                    size="small"
            />
        {% else %}
            <twig:Button
                    color="{{ themeColor }}"
                    mode="white"
                    label="Suivant"
                    disabled="{{ true }}"
                    icon="{{ source('@SFToolbox/icons/chevron-right.svg') }}"
                    iconPlacement="right"
                    size="small"
            />
        {% endif %}
    </div>
{% endif %}
