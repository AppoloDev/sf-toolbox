<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0">
    <meta name="robots" content="index, follow">
    <title>{{ siteTitle }}</title>
    <link rel="shortcut icon" href="{{ asset('assets/images/favicon.png') }}">

    {{ vite_entry_link_tags('theme') }}
    {% block stylesheets %}{% endblock %}
</head>
<body class="page_error {% block bodyColor %}text-{{ themeColor }}-500{% endblock %}">
    <div class="container">
        {% block logo %}
            <a href="/" rel="noopener" class="logo">
                <img src="{{ asset('assets/images/logo.png') }}" alt="Logo"/>
            </a>
        {% endblock %}

        <div class="content">
            {% block title %}
                <h1>{{ 'an_error_has_occurred'|trans }}</h1>
            {% endblock %}

            {% block message %}
                <p>
                    {{ 'the_page_you_requested_is_inaccessible'|trans }} <br/>
                </p>
            {% endblock %}
        </div>

        {% block button %}
            <twig:ButtonLink color="{{ themeColor }}" mode="solid" label="{{ 'back_to_home'|trans }}" link="/" />
        {% endblock %}
    </div>

    {{ vite_entry_script_tags('theme') }}
    {% block javascripts %}{% endblock %}
</body>
</html>
