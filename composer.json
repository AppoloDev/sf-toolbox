{
    "name": "appolodev/sf-toolbox",
    "description": "Toolbox for Symfony",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Fredxd",
            "email": "frederic@appolo.fr"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "ext-intl": "*",
        "ext-zip": "*",
        "php": ">=8.4",
        "twig/twig": "^3.0",
        "doctrine/orm": "^3.0",
        "symfony/serializer": "^8.0",
        "symfony/uid": "^8.0",
        "symfony/console": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/ux-twig-component": "^3.1.0",
        "symfony/form": "^8.0",
        "knplabs/knp-paginator-bundle": "^6.2",
        "symfony/security-bundle": "^8.0",
        "symfony/doctrine-bridge": "^8.0",
        "league/csv": "^9.9",
        "symfony/messenger": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/expression-language": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/ux-icons": "^3.1.0",
        "symfony/filesystem": "^8.0"
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.49",
        "friendsofphp/php-cs-fixer": "^3.22",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AppoloDev\\SFToolboxBundle\\": "src/"
        }
    },
    "scripts": {
        "auto-scripts": {
            "ux:icon:import fa6-solid:bars": "symfony-cmd",
            "ph:x": "symfony-cmd",
            "fa6-solid:chevron-left": "symfony-cmd",
            "fa6-solid:chevron-right": "symfony-cmd",
            "fa6-solid:sort": "symfony-cmd",
            "fa6-solid:sort-up": "symfony-cmd",
            "fa6-solid:sort-down": "symfony-cmd",
            "iconoir:search": "symfony-cmd",
            "fa6-solid:download": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    }
}
