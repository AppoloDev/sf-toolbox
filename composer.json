        "symfony/mailer": "^8.1",
        "symfony/ux-twig-component": "^3.1.0",
        "symfony/form": "^8.1",
        "knplabs/knp-paginator-bundle": "^6.2",
        "symfony/security-bundle": "^8.1",
        "symfony/doctrine-bridge": "^8.1",
        "league/csv": "^9.9",
        "symfony/messenger": "^8.1",
        "symfony/mime": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/expression-language": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/ux-icons": "^3.1.0",
        "symfony/filesystem": "^8.1"
